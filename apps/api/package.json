{
  "name": "@infomemory/api",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @infomemory/core",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build --workspace @infomemory/core && npm run build",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build --workspace @infomemory/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "token": "tsx src/cli/generate-access-token.ts"
  },
  "dependencies": {
    "@infomemory/core": "*",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "zod": "^4.5.4"
  }
}
