NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./var/infomemory.sqlite
APP_TIMEZONE=Asia/Shanghai

# Development/test may use trusted_headers. Production must use bearer.
AUTH_MODE=trusted_headers
# Required for bearer mode: at least 32 random bytes. Never commit the real value.
AUTH_SECRET=
AUTH_ISSUER=infomemory-agent
AUTH_AUDIENCE=infomemory-api

HTTP_BODY_LIMIT_BYTES=4194304
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_CONNECTION_TIMEOUT_MS=125000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_KEYS=10000

# Keep generation disabled until the API key shared in chat has been rotated.
LLM_ENABLED=false
LLM_BASE_URL=https://llm-gw.bupt.edu.cn/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000

# Fill these after creating and authorizing the Feishu app.
FEISHU_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_API_TIMEOUT_MS=10000
# Enable enterprise installation OAuth only after registering the exact
# callback URL in the Feishu developer console. Production requires HTTPS.
FEISHU_OAUTH_ENABLED=false
FEISHU_OAUTH_REDIRECT_URI=
# OAuth v3 endpoints; keep defaults unless using a regional gateway.
FEISHU_OAUTH_AUTHORIZATION_BASE_URL=https://accounts.feishu.cn
FEISHU_OAUTH_TOKEN_URL=https://accounts.feishu.cn/oauth/v3/token
# Space- or comma-separated permissions requested during installation.
FEISHU_OAUTH_SCOPES=im:message,docx:read
# 32-byte raw/base64url/hex key. Inject from a Secret Manager; never commit.
FEISHU_TOKEN_ENCRYPTION_KEY=
FEISHU_OAUTH_STATE_TTL_MS=600000
# Optional. Required only when Feishu encrypts event payloads.
FEISHU_ENCRYPT_KEY=
# Keep false until the Feishu app has been authorized with message-send scope.
FEISHU_NOTIFICATIONS_ENABLED=false
REMINDER_POLL_INTERVAL_MS=15000

# Connector ingress defaults to sync in development/test and async in production.
# Async mode verifies/decrypts, persists a redacted inbox row, then ACKs quickly.
CONNECTOR_PROCESSING_MODE=sync
CONNECTOR_WORKER_ENABLED=false
CONNECTOR_WORKER_INTERVAL_MS=5000
CONNECTOR_WORKER_BATCH_SIZE=25
CONNECTOR_WORKER_LEASE_MS=300000
CONNECTOR_MAX_ATTEMPTS=8
CONNECTOR_BACKOFF_BASE_MS=1000
CONNECTOR_BACKOFF_MAX_MS=300000
