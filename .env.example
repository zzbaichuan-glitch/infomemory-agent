NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./var/infomemory.sqlite
APP_TIMEZONE=Asia/Shanghai

# Development/test may use trusted_headers. Production must use bearer.
AUTH_MODE=trusted_headers
# Required for bearer mode: at least 32 random bytes. Never commit the real value.
AUTH_SECRET=
AUTH_ISSUER=infomemory-agent
AUTH_AUDIENCE=infomemory-api

HTTP_BODY_LIMIT_BYTES=4194304
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_CONNECTION_TIMEOUT_MS=125000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_KEYS=10000

# Keep generation disabled until the API key shared in chat has been rotated.
LLM_ENABLED=false
LLM_BASE_URL=https://llm-gw.bupt.edu.cn/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=15000

# Fill these after creating and authorizing the Feishu app.
FEISHU_VERIFICATION_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_API_TIMEOUT_MS=10000
# Optional. Required only when Feishu encrypts event payloads.
FEISHU_ENCRYPT_KEY=
# Keep false until the Feishu app has been authorized with message-send scope.
FEISHU_NOTIFICATIONS_ENABLED=false
REMINDER_POLL_INTERVAL_MS=15000
